__v0_runtime_loader.js
__v0_devtools.tsx
__v0_jsx-dev-runtime.ts
.snowflake/
.v0-trash/
.vercel/

# Environment variables
.env
.env*.local

# Common ignores
node_modules
.next/
.DS_Store

# Superpowers brainstorm scratch
.superpowers/

# v0 raw import dump (Next.js scaffold — reference only, ported into frontend/)
frontendv0/

# crop-name i18n generator artifacts (regenerable via tools/gen_crop_names.py)
backend/tools/out/
backend/tools/crop_wikidata_cache.json

# Real-data ingestion: manual downloads / large raw source files (never commit)
backend/tools/ingest/_staging/*
!backend/tools/ingest/_staging/.gitkeep

# Trained model weights. The LSTM price-forecast models (~413MB, 3,977 files)
# are NOT deployed — price_outlook falls back to historical trend without them.
# Only the tiny YieldMLP bundle is committed (powers the Advisor + channel engine).
saved_models/*
!saved_models/yield_model.pt
!saved_models/yield_vocabs.json
!saved_models/yield_target_scalers.json
!saved_models/yield_metrics.json
# Catalog of LSTM forecast models (the .pt files themselves live in a separate
# repo and are lazily fetched; this lets /forecast/available work in prod).
!saved_models/forecast_manifest.json
.vercel
